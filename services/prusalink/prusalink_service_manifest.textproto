metadata {
  id {
    package: "ai.omts"
    name: "prusalink"
  }
  vendor {
    display_name: "OMTS"
  }
  display_name: "PrusaLink LAN adapter"
  documentation {
    description: "PrusaLink telemetry, opt-in job commands, and a model (STL) of each print job built from its G-code."
  }
}
service_def {
  config_message_full_name: "omts.prusalink.PrusaLinkConfig"
  service_proto_prefixes: "/omts.prusalink.PrusaLinkService/"
  http_config {}
  real_spec {
    image {
      archive_filename: "prusalink_image.tar"
      settings {
        args: ["--runtime-context=/etc/intrinsic/runtime_config.pb"]
      }
    }
  }
  sim_spec {
    image {
      archive_filename: "prusalink_image.tar"
      settings {
        args: ["--runtime-context=/etc/intrinsic/runtime_config.pb"]
      }
    }
  }
}
