# proto-file: intrinsic/skills/proto/skill_manifest.proto
# proto-message: intrinsic_proto.skills.SkillManifest

id { package: "ai.omts" name: "register_pose_estimator" }
display_name: "Register pose estimator"
vendor { display_name: "OMTS" }
documentation { description: "Registers a pose estimator for an installed scene-object asset, with the cell's train service (ai.intrinsic.ioc_train_service). Reads the asset and creates the pose estimator asset. Never touches the world or a robot." }
options {
  supports_cancellation: true
  execution_timeout { seconds: 900 }
  python_config {
    skill_module: "skills.perception.register_pose_estimator"
    proto_module: "skills.perception.register_pose_estimator_pb2"
    create_skill: "skills.perception.register_pose_estimator.RegisterPoseEstimator"
  }
}
parameter { message_full_name: "omts.perception.RegisterPoseEstimatorParams" }
return_type { message_full_name: "omts.perception.RegisterPoseEstimatorResult" }
status_info { code: 2001 title: "Invalid register_pose_estimator parameters" }
status_info { code: 2002 title: "Installed asset or train service unavailable" }
status_info { code: 2003 title: "Pose estimator training or saving failed" }
