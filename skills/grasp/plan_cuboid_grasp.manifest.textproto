id { package: "ai.omts" name: "plan_cuboid_grasp" }
display_name: "Plan cuboid grasp"
vendor { display_name: "OMTS" }
documentation { description: "Moves a part's world object to its estimated pose and publishes the grasp and pre-grasp frames for it: the gripper takes the part by its centre, aligned with its long axis, optionally pitched so the approach leans away from the robot. Changes the belief world only." }
options {
  supports_cancellation: false
  execution_timeout { seconds: 30 }
  python_config {
    skill_module: "skills.grasp.plan_cuboid_grasp"
    proto_module: "skills.grasp.plan_cuboid_grasp_pb2"
    create_skill: "skills.grasp.plan_cuboid_grasp.PlanCuboidGrasp"
  }
}
parameter { message_full_name: "omts.grasp.PlanCuboidGraspParams" }
return_type { message_full_name: "omts.grasp.PlanCuboidGraspResult" }
status_info { code: 2101 title: "Invalid plan_cuboid_grasp parameters" }
status_info { code: 2102 title: "A world object or frame the grasp needs is missing" }
status_info { code: 2103 title: "The part is below the minimum safe height" }
