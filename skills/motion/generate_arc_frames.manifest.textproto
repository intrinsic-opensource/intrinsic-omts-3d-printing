# proto-file: intrinsic/skills/proto/skill_manifest.proto
# proto-message: intrinsic_proto.skills.SkillManifest

id { package: "ai.omts" name: "generate_arc_frames" }
display_name: "Generate arc frames"
vendor { display_name: "OMTS" }
documentation { description: "Writes tool frames that swing a grip point along a circular arc about a pivot axis (for example a door handle about its hinge): <prefix>_pregrasp, <prefix>_grasp, <prefix>_wp_00.. and <prefix>_retreat, children of the root object, for move_robot to target. Existing frames of the same names are moved. Never moves a robot." }
options {
  # One instantaneous world update: nothing to cancel.
  supports_cancellation: false
  python_config {
    skill_module: "skills.motion.arc_frames_skill"
    proto_module: "skills.motion.generate_arc_frames_pb2"
    create_skill: "skills.motion.arc_frames_skill.GenerateArcFrames"
  }
}
parameter { message_full_name: "omts.motion.GenerateArcFramesParams" }
return_type { message_full_name: "omts.motion.GenerateArcFramesResult" }
status_info { code: 2101 title: "Invalid generate_arc_frames parameters" }
status_info { code: 2102 title: "pivot_frame or grip_frame is not set" }
status_info { code: 2103 title: "A referenced frame or object is missing" }
status_info { code: 2104 title: "The grip point lies on the pivot axis" }
status_info { code: 2105 title: "RADIAL: the tool azimuth is undefined" }
status_info { code: 2106 title: "Reading or writing the world failed" }
