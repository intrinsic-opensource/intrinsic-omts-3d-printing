# proto-file: intrinsic/skills/proto/skill_manifest.proto
# proto-message: intrinsic_proto.skills.SkillManifest

id { package: "ai.omts" name: "read_printer_status" }
display_name: "Read printer status"
vendor { display_name: "OMTS" }
documentation { description: "Reads fresh PrusaLink telemetry and returns an advisory unload decision. Never moves a robot." }
options {
  supports_cancellation: true
  python_config {
    skill_module: "skills.printer.printer_skills"
    proto_module: "skills.printer.read_printer_status_pb2"
    create_skill: "skills.printer.printer_skills.ReadPrinterStatus"
  }
}
dependencies {
  required_equipment {
    key: "printer"
    value {
      capability_names: "omts.prusalink.PrusaLinkService"
      sharing_type: READ
    }
  }
}
parameter { message_full_name: "omts.printer.ReadPrinterStatusParams" }
return_type { message_full_name: "omts.printer.PrinterReadiness" }
status_info { code: 1001 title: "Invalid printer skill parameters or equipment" }
status_info { code: 1002 title: "PrusaLink service unavailable" }
status_info { code: 1004 title: "Invalid or stale printer observation" }
