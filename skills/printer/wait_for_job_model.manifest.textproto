# proto-file: intrinsic/skills/proto/skill_manifest.proto
# proto-message: intrinsic_proto.skills.SkillManifest

id { package: "ai.omts" name: "wait_for_job_model" }
display_name: "Wait for job model"
vendor { display_name: "OMTS" }
documentation { description: "Waits until the printer service has built the STL model of a print job from its G-code. Returns READY or TIMED_OUT; fails if the conversion failed or the job changed. Never moves a robot." }
options {
  supports_cancellation: true
  execution_timeout { seconds: 3620 }
  python_config {
    skill_module: "skills.printer.job_model_skills"
    proto_module: "skills.printer.job_model_pb2"
    create_skill: "skills.printer.job_model_skills.WaitForJobModel"
  }
}
dependencies {
  required_equipment {
    key: "printer"
    value {
      capability_names: "omts.prusalink.PrusaLinkService"
      sharing_type: READ
    }
  }
}
parameter { message_full_name: "omts.printer.WaitForJobModelParams" }
return_type { message_full_name: "omts.printer.JobModelReadiness" }
status_info { code: 1001 title: "Invalid job model skill parameters or equipment" }
status_info { code: 1002 title: "PrusaLink service unavailable" }
status_info { code: 1003 title: "Job model failed, or the job changed" }
status_info { code: 1004 title: "Invalid job model observation" }
