# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# Door test layout (//models/printer:layout=door_test): the printer moved 21 cm
# straight away from the robot (d = 0.80 m, same side position, in line with the
# arm; from 0.81 the grasp is at the edge of the arm's reach). Applied after printer.updates and printed_part.updates, so it overrides
# both; the part moves with the bed.

# The printer is attached to the ground slab (rebot_ground, static in Gazebo) so
# that it cannot be pushed or dragged by the arm: Gazebo then welds its base to
# the ground. The door hinge and the crank handle stay free.
updates {
  reparent_object {
    object {
      by_name {
        object_name: "printer"
      }
    }
    parent_object {
      reference {
        by_name {
          object_name: "rebot_ground"
        }
      }
      entity_filter {
        include_base_entity: true
      }
    }
  }
}
updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    a_t_b {
      position {
        x: 0.8
        y: -0.0064
        z: 0
      }
      orientation {
        x: 0
        y: 0
        z: 0.70710678
        w: 0.70710678
      }
    }
  }
}
updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    a_t_b {
      position {
        x: 0.7705
        y: 0
        z: 0.1584
      }
      orientation {
        x: 0
        y: 0
        z: 0
        w: 1
      }
    }
  }
}
