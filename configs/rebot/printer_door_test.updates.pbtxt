# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# Door test layout (//models/printer:layout=door_test): the printer at d = 0.70 m
# and 0.3 m to the robot's left, where the arm can reach the clip's lever through
# a wide door angle (research/HANDOFF.md, 5e). Applied after printer.updates and
# printed_part.updates, so it overrides both; the part moves with the bed.

updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    a_t_b {
      position {
        x: 0.70
        y: 0.3
        z: 0
      }
      orientation {
        x: 0
        y: 0
        z: 0.70710678
        w: 0.70710678
      }
    }
  }
}
updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    a_t_b {
      position {
        x: 0.6705
        y: 0.3064
        z: 0.1584
      }
      orientation {
        x: 0
        y: 0
        z: 0
        w: 1
      }
    }
  }
}
