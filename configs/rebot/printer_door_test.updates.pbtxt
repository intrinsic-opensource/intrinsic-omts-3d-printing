# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# Door test layout (//models/printer:layout=door_test): the printer moved 8.5 cm
# straight away from the robot (d = 0.675 m, same side position), so the door
# plane is 0.47 m from the robot's base axis and the door can swing wide without
# touching the arm. Applied after printer.updates and printed_part.updates, so it
# overrides both; the part moves with the bed.

updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    a_t_b {
      position {
        x: 0.675
        y: -0.0064
        z: 0
      }
      orientation {
        x: 0
        y: 0
        z: 0.70710678
        w: 0.70710678
      }
    }
  }
}
updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    a_t_b {
      position {
        x: 0.6455
        y: 0
        z: 0.1584
      }
      orientation {
        x: 0
        y: 0
        z: 0
        w: 1
      }
    }
  }
}
