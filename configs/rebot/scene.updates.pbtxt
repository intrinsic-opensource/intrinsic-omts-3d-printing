# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# Named frames for the reBot cell, used by omts_app
# (configs/rebot/app_config.yaml), and its starting joint configuration.

# view: the tool pose from which the wrist camera sees the bed (step 3a).
# The tool points 50 deg down into the printer with its usual roll, so the
# camera sits above the gripper, outside the printer's front at (0.269, 0,
# 0.349), 0.38 m from the bed centre and looking straight in. The whole bed
# is beyond the depth sensor's near clip (0.25 m). The printer's closed top
# rules out looking straight down (checked offline, steps 3a and 3c).
updates {
  create_frame {
    new_frame_name: "view"
    parent_t_new_frame {
      position {
        x: 0.2929
        y: -0.024
        z: 0.2378
      }
      orientation {
        x: 0.906308
        y: 0
        z: 0.422618
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

# omts_app's "machine" frames (configs/rebot/app_config.yaml, step 3c). With
# no machine, OMTS's load and unload subtrees still set the part down here and
# pick it up again, so they are A, on the ground behind the robot, 0.45 m out
# at 130 deg from the printer's direction. The tool is tilted 60 deg about the
# jaw axis, leaning away from the robot along the part's x axis, which is the
# grasp cuboid_center makes on the bed (grasp.approach_tilt_degrees), so the
# part is set down flat. Closer in or further round, a joint runs into its
# limit at this tilt (offline check). place_vise holds the part at its resting
# height (z = 0.015); the app config presses it 2 mm further when setting it
# down (cycle.place_press_meters) and lists rebot_ground as a support, so the
# re-grasp here closes at the part's centre.
# pre_place_vise backs off 8 cm along the approach;
# machine_approach is 10 cm above it.
updates {
  create_frame {
    new_frame_name: "place_vise"
    parent_t_new_frame {
      position {
        x: -0.2893
        y: 0.3447
        z: 0.015
      }
      orientation {
        x: -0.365998
        y: -0.784886
        z: -0.211309
        w: 0.453154
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

updates {
  create_frame {
    new_frame_name: "pre_place_vise"
    parent_t_new_frame {
      position {
        x: -0.2447
        y: 0.2916
        z: 0.055
      }
      orientation {
        x: -0.365998
        y: -0.784886
        z: -0.211309
        w: 0.453154
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

updates {
  create_frame {
    new_frame_name: "machine_approach"
    parent_t_new_frame {
      position {
        x: -0.2447
        y: 0.2916
        z: 0.155
      }
      orientation {
        x: -0.365998
        y: -0.784886
        z: -0.211309
        w: 0.453154
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

# The arm starts at "park_left" (the folded "home" turned to the robot's
# left), not at "home": folded straight ahead, the gripper reaches into the
# printer's front opening.
updates {
  update_object_joints {
    object {
      by_name {
        object_name: "rebot"
      }
    }
    joint_positions: 1.5708
    joint_positions: -0.05
    joint_positions: -0.05
    joint_positions: 0
    joint_positions: 0
    joint_positions: 0
  }
}
