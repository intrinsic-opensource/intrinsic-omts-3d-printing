<?xml version="1.0" ?>
<sdf xmlns:intrinsic="https://intrinsic.ai/" version="1.8">
  <model name="3d_printer">
  <self_collide>false</self_collide>
    <link name="base_link">
    <inertial>
         <mass>25.0</mass>
        <inertia>
          <ixx>1.20</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>1.10</iyy>
          <iyz>0.0</iyz>
          <izz>1.30</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>frame.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.35 0.28 0.2 1.0</ambient>
          <diffuse>0.54 0.45 0.33 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
  <collision name="col_bottom_base">
    <pose>0.0 0.0 0.069 0 0 0</pose>
    <geometry>
      <box>
        <size>0.376 0.384 0.138</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_front_dial">
    <pose>0.0 0.235 0.035 0 0 0</pose>
    <geometry>
      <box>
        <size>0.160 0.055 0.060</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_left_wall">
    <pose>-0.198 0.0 0.277 0 0 0</pose>
    <geometry>
      <box>
        <size>0.020 0.416 0.554</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_right_wall">
    <pose>0.198 0.0 0.277 0 0 0</pose>
    <geometry>
      <box>
        <size>0.020 0.416 0.554</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_back_wall">
    <pose>0.0 -0.202 0.277 0 0 0</pose>
    <geometry>
      <box>
        <size>0.376 0.020 0.554</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_front_left_bezel">
    <pose>-0.180 0.198 0.275 0 0 0</pose>
    <geometry>
      <box>
        <size>0.036 0.020 0.440</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_front_right_bezel">
    <pose>0.180 0.198 0.275 0 0 0</pose>
    <geometry>
      <box>
        <size>0.036 0.020 0.440</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_top_front_header">
    <pose>0.0 0.198 0.525 0 0 0</pose>
    <geometry>
      <box>
        <size>0.376 0.020 0.058</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_front_mid_rail">
    <pose>0.0 0.188 0.386 0 0 0</pose>
    <geometry>
      <box>
        <size>0.340 0.032 0.030</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_internal_right_tower">
    <pose>-0.162 -0.030 0.260 0 0 0</pose>
    <geometry>
      <box>
        <size>0.085 0.336 0.240</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_internal_left_tower">
    <pose>0.162 -0.030 0.260 0 0 0</pose>
    <geometry>
      <box>
        <size>0.070 0.336 0.240</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_x_axis_rail">
    <pose>0.0 0.010 0.420 0 0 0</pose>
    <geometry>
      <box>
        <size>0.340 0.055 0.040</size>
      </box>
    </geometry>
  </collision>

  <collision name="col_hotend_assembly">
    <pose>0.0 0.039 0.445 0 0 0</pose>
    <geometry>
      <box>
        <size>0.130 0.080 0.145</size>
      </box>
    </geometry>
  </collision>
    </link>

    <link name="heatbed_link">
      <pose relative_to="base_link">0 0 0.0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.18 0 0 0</pose>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.01</iyy><iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>heatbed.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.12 0.03 1.0</ambient>
          <diffuse>0.08 0.35 0.12 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>heatbed.obj</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <joint name="bed_joint" type="fixed">
      <parent>base_link</parent>
      <child>heatbed_link</child>
    </joint>

    <link name="door_link">
  <pose relative_to="base_link">0.174 0.205 0.279 0 0 -3.14159</pose>

  <inertial>
    <pose>-0.174 0.0235 0.018 0 0 0</pose>
    <mass>0.45</mass>
    <inertia>
      <ixx>0.0079</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
      <iyy>0.0128</iyy><iyz>0.0</iyz>
      <izz>0.0049</izz>
    </inertia>
  </inertial>

  <visual name="door_visual">
    <pose>-0.174 -0.205 -0.214 0 0 0</pose>
    <geometry>
      <mesh><uri>door.obj</uri></mesh>
    </geometry>
    <material>
      <ambient>0.85 0.92 0.95 0.85</ambient>
      <diffuse>0.85 0.92 0.95 0.85</diffuse>
      <specular>0.9 0.9 0.9 1.0</specular>
    </material>
  </visual>

  <visual name="aruco_1_tile">
    <!-- 0.5 mm in front of the aruco_1 frame (y 0.0075) so the tile does not
         z-fight with the glass. -->
    <pose>-0.09000 0.00800 0.18000 -1.570796 -0.000000 3.141593</pose>
    <geometry><mesh><uri>aruco_1.glb</uri></mesh></geometry>
  </visual>

  <!-- The fixed half of the D handle (src/core/door.py HANDLE_*): two arms in
       the door's plane, from the pane's free edge out to rounded corners 0.10 m
       beyond it, so the pane is never between the robot and the bar at any door
       angle. The bar between the corners is the link crank_handle, which turns
       on the joint crank_pivot. The arms and corners share one colour; the turning bar is light blue. -->
  <visual name="handle_arm_top_v"><pose>-0.399 0.016 0.235 0 1.570796 0</pose>
    <geometry><cylinder><radius>0.006</radius><length>0.110</length></cylinder></geometry>
    <material><ambient>0.58 0.25 0.85 1</ambient><diffuse>0.58 0.25 0.85 1</diffuse></material></visual>
  <collision name="handle_arm_top_c"><pose>-0.399 0.016 0.235 0 1.570796 0</pose>
    <geometry><cylinder><radius>0.006</radius><length>0.110</length></cylinder></geometry></collision>
  <visual name="handle_arm_bottom_v"><pose>-0.399 0.016 0.115 0 1.570796 0</pose>
    <geometry><cylinder><radius>0.006</radius><length>0.110</length></cylinder></geometry>
    <material><ambient>0.58 0.25 0.85 1</ambient><diffuse>0.58 0.25 0.85 1</diffuse></material></visual>
  <collision name="handle_arm_bottom_c"><pose>-0.399 0.016 0.115 0 1.570796 0</pose>
    <geometry><cylinder><radius>0.006</radius><length>0.110</length></cylinder></geometry></collision>
  <visual name="handle_corner_top_v"><pose>-0.454 0.016 0.235 0 0 0</pose>
    <geometry><sphere><radius>0.008</radius></sphere></geometry>
    <material><ambient>0.58 0.25 0.85 1</ambient><diffuse>0.58 0.25 0.85 1</diffuse></material></visual>
  <collision name="handle_corner_top_c"><pose>-0.454 0.016 0.235 0 0 0</pose>
    <geometry><sphere><radius>0.008</radius></sphere></geometry></collision>
  <visual name="handle_corner_bottom_v"><pose>-0.454 0.016 0.115 0 0 0</pose>
    <geometry><sphere><radius>0.008</radius></sphere></geometry>
    <material><ambient>0.58 0.25 0.85 1</ambient><diffuse>0.58 0.25 0.85 1</diffuse></material></visual>
  <collision name="handle_corner_bottom_c"><pose>-0.454 0.016 0.115 0 0 0</pose>
    <geometry><sphere><radius>0.008</radius></sphere></geometry></collision>
  <visual name="handle_mount_top_v"><pose>-0.350 0.01275 0.235 0 0 0</pose>
    <geometry><box><size>0.016 0.0185 0.016</size></box></geometry>
    <material><ambient>0.58 0.25 0.85 1</ambient><diffuse>0.58 0.25 0.85 1</diffuse></material></visual>
  <collision name="handle_mount_top_c"><pose>-0.350 0.01275 0.235 0 0 0</pose>
    <geometry><box><size>0.016 0.0185 0.016</size></box></geometry></collision>
  <visual name="handle_mount_bottom_v"><pose>-0.350 0.01275 0.115 0 0 0</pose>
    <geometry><box><size>0.016 0.0185 0.016</size></box></geometry>
    <material><ambient>0.58 0.25 0.85 1</ambient><diffuse>0.58 0.25 0.85 1</diffuse></material></visual>
  <collision name="handle_mount_bottom_c"><pose>-0.350 0.01275 0.115 0 0 0</pose>
    <geometry><box><size>0.016 0.0185 0.016</size></box></geometry></collision>

  <collision name="door_pane_col">
    <pose>-0.174 0.005 0.02 0 0 0</pose>
    <geometry><box><size>0.360 0.005 0.460</size></box></geometry>
  </collision>
</link>

<joint name="door_hinge" type="revolute">
  <parent>base_link</parent>
  <child>door_link</child>
  <axis>
    <xyz>0 0 1</xyz>
    <limit>
      <lower>0.0</lower>
      <upper>3.14159</upper>
      <effort>5.0</effort>
      <velocity>2.0</velocity>
    </limit>
    <dynamics>
      <damping>0.5</damping>
      <friction>0.2</friction>
    </dynamics>
  </axis>
</joint>

    <!-- The turning bar of the D handle: the straight middle part, held by the
         gripper. It is a rectangular prism (door.HANDLE_BAR_*): its 0.040 m
         side lies along the approach when the door is closed, so the fingers
         close across the 0.016 m thickness. It turns freely about its own
         vertical axis on crank_pivot, so the gripper keeps its orientation
         while the door swings; the force goes through the pivot, the corners
         and the arms to the door. Its collision is the only one on this link
         (the planner's gripper exclusion is "printer:crank_handle"). -->
    <link name="crank_handle">
      <pose relative_to="door_link">-0.454 0.016 0.175 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00009</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00009</iyy><iyz>0</iyz><izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="bar_v">
        <pose>0 0 0 0 0 1.095</pose>
        <geometry><box><size>0.040 0.016 0.120</size></box></geometry>
        <material><ambient>0.55 0.80 1.0 1</ambient><diffuse>0.55 0.80 1.0 1</diffuse></material>
      </visual>
      <collision name="bar_c">
        <pose>0 0 0 0 0 1.095</pose>
        <geometry><box><size>0.040 0.016 0.100</size></box></geometry>
        <surface><friction><ode><mu>3.0</mu><mu2>3.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <joint name="crank_pivot" type="revolute">
      <parent>door_link</parent>
      <child>crank_handle</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-6.4</lower>
          <upper>6.4</upper>
          <effort>1.0</effort>
          <velocity>10.0</velocity>
        </limit>
        <dynamics>
          <damping>0.002</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Frames from src/core/door.py (checked by test_door_model). -->
    <frame name="door_hinge_axis" attached_to="base_link" intrinsic:create_entity="true">
      <pose>0.174 0.205 0.279 0 0 0</pose>
    </frame>
    <frame name="aruco_1" attached_to="door_link" intrinsic:create_entity="true">
      <pose relative_to="door_link">-0.09 0.0075 0.18 -1.570796 -0.000000 3.141593</pose>
    </frame>

  </model>
</sdf>