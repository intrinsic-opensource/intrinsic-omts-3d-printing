<sdf version="1.9">
  <model name="test_benchy">
    <link name="base_link">
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>4.1e-06</ixx>
          <iyy>7.4e-06</iyy>
          <izz>5.7e-06</izz>
        </inertia>
      </inertial>
      <!-- test_benchy.stl is in metres with its origin at the centre of
           its bounding box (59.5 x 31.0 x 48.0 mm), so the part's frame is
           the box centre. The origin is in the mesh itself, not a pose here:
           the pose estimator's registration exports the mesh without the
           visual's pose. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>test_benchy.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.85 0.2 0.2 1</ambient>
          <diffuse>0.85 0.2 0.2 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>test_benchy.stl</uri>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
